# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# 注:ESP32-C3 无 PSRAM,故不设 CONFIG_SPIRAM。

# --- Flash ---
# FoloToy AI Passport 当前产品/固件基线使用 8MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8MB 镜像头，关闭 detect，便于 idf.py merge-bin。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# 默认模板只保留 NVS、PHY data 和占用剩余空间的 factory app；用户可按需修改。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台:USB-Serial-JTAG(C3 原生 USB,GPIO18/19)---
# 不用 UART0:其默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
# 20 ms display refresh period targets up to 50 FPS when rendering and SPI
# transfer complete within the same budget.
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# LVGL 内置 malloc 池大小(KB)。它是独立静态区、不与系统堆共享,配大了会白白占用 RAM。
# OpenClaw 首页保留像素龙虾、状态图标、波形和多页文本；28KB 为 LVGL
# 对象留出空间，同时给 Wi-Fi、BLE 和 I2S DMA 保留内部 RAM。
CONFIG_LV_MEM_SIZE_KILOBYTES=28
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_FONT_FMT_TXT_LARGE=y
# Keep TLS record state stable across fragmented network reads.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=n
# Keep the legal 16 KB inbound TLS record size; client writes fit in 4 KB.
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
# Verify certificates during the handshake without retaining the peer chain afterward.
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n
CONFIG_MBEDTLS_SSL_RENEGOTIATION=n
CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS=y
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y

# Three NTP servers: a domestic one first, then global fallbacks.
CONFIG_LWIP_SNTP_MAX_SERVERS=3
# Without a startup delay the first request goes out immediately.
CONFIG_LWIP_SNTP_STARTUP_DELAY=n

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
# 内部 RAM 不足:连上网关后只剩约 12 KB。Wi-Fi 收发和 FreeRTOS 的热路径
# 改从 Flash 执行,约多出 32 KB 堆,代价是 Wi-Fi 吞吐略降。
# BT_CTRL_RUN_IN_FLASH_ONLY 会让应用分区溢出,不开。
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y

# --- Bluetooth LE / NimBLE ---
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
CONFIG_BT_CTRL_BLE_MAX_ACT=3
CONFIG_BT_NIMBLE_HOST_BASED_PRIVACY=n
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=3

# Prefer TLS 1.3 when the gateway supports it; keep TLS 1.2 compatibility.
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y

# Shadowsocks uses aes-256-cfb, which TLS already links. ChaCha20-Poly1305
# is left out to keep the size-constrained application small.
CONFIG_MBEDTLS_CHACHA20_C=n
CONFIG_MBEDTLS_POLY1305_C=n
CONFIG_MBEDTLS_CHACHAPOLY_C=n
